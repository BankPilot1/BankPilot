# OpenAI-compatible endpoint. Include /v1 if required by your provider.
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
AI_PROVIDER=deepseek
# Other providers: AI_PROVIDER=openai-compatible, replace base/model.
# Optional compatibility controls: AI_TOKEN_PARAMETER=max_completion_tokens
# AI_TEMPERATURE=none
# AI_EXTRA_BODY={}
AI_REQUIRE_ACCESS_CODE=false
# Optional: isolate demo on public hosting with a team access code.
TEAM_ACCESS_CODE=
